TRENDING_VIDEOS_ENABLED=true
TRENDING_REGION_CODE=MM
TRENDING_CATEGORY_ID=1
TRENDING_DISCOVERY_QUERIES="official movie trailer|official teaser|new movie trailer|upcoming movie trailer"
TRENDING_FRESHNESS_DAYS=30
TRENDING_CACHE_TTL_MINUTES=15
TRENDING_POOL_SIZE=50
TRENDING_RECENT_HISTORY_SIZE=10
TRENDING_MIN_DURATION_SECONDS=30
TRENDING_MAX_DURATION_SECONDS=0

TASK_PRICE_MIN_PERCENT=1
TASK_PRICE_MAX_PERCENT=10
