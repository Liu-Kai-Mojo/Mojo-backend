DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_SECRET="generate-a-long-random-secret-at-least-32-characters"
NODE_ENV=production
PORT=8787
FRONTEND_ORIGINS="https://box-office-mojo.pages.dev,https://mojo-client.pages.dev,https://mojo-admin.pages.dev,https://mojo-administrator.pages.dev,https://mojo-owner.pages.dev"

OWNER_IDENTIFIER="owner@example.com"
OWNER_PASSWORD="change-this-to-a-strong-password"

# Server-side movie/video providers. Never expose these to any frontend.
YOUTUBE_API_KEY="server-only-YouTube-Data-API-key"
TMDB_API_READ_TOKEN="server-only-TMDB-API-read-token"

# Movie/video cache and controlled YouTube discovery.
TRAILER_VIDEOS_ENABLED=true
YOUTUBE_RELEVANCE_LANGUAGE=en
TRAILER_CACHE_TTL=60
TRAILER_REFRESH_INTERVAL_MINUTES=60
TRAILER_REPEAT_COOLDOWN_HOURS=24
TRAILER_MIN_DURATION_SECONDS=30
TRAILER_MAX_DURATION_SECONDS=600
TRAILER_FRESHNESS_DAYS=30
TRAILER_MAX_CANDIDATES=50
TRENDING_POOL_SIZE=30
TRENDING_RECENT_HISTORY_SIZE=10
TRENDING_DISCOVERY_QUERIES="<movie title> official trailer|<movie title> trailer|<movie title> official clip|<movie title> movie clip"
TRENDING_DISCOVERY_ORDERS="relevance"

# Task pricing/watch settings used by the backend authority.
TASK_PRICE_MIN_PERCENT=1
TASK_PRICE_MAX_PERCENT=10
TASK_PRICE_MIN_ABSOLUTE_CENTS=1
TASK_PRICE_MAX_ABSOLUTE_CENTS=100000
TASK_PRICE_MIN_REMAINING_BALANCE_CENTS=0
TASK_REQUIRED_WATCH_SECONDS=2.5
